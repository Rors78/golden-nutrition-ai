{
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Bash(./venv/bin/python -m pytest*)",
      "Bash(./venv/bin/python run.py*)",
      "Bash(./venv/bin/pip install*)",
      "Bash(python3 -m py_compile*)",
      "Bash(curl -s http://localhost:8501*)",
      "Bash(fuser -k 8501/tcp)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  }
}
